# Development-server K3d SSH target. Copy this file to .env and fill in the
# server details. Authentication uses your SSH agent or ~/.ssh/config by default.
DEV_CLUSTER_IP=
DEV_CLUSTER_USER=

# Optional explicit private-key path. Leave empty to use SSH agent/configuration.
DEV_CLUSTER_SSH_KEY=

# K3d cluster to create, reuse, and stop on the development server.
CLUSTER_NAME=manticore-streams-dev

# Scratch checkout on the remote server. The remote command synchronizes the
# current working tree here before building and deploying it.
DEV_CLUSTER_WORKDIR=/tmp/manticore-streams-k3s
