            <version>4.3</version>
        </dependency>
        <dependency>
            <groupId>com.schibsted.spt.data</groupId>
            <artifactId>jslt</artifactId>
            <version>0.1.10</version>
        </dependency>
        <dependency>
            <groupId>com.google.guava</groupId>
